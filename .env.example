# ------------------------------------------------------------
#  Le Beau Défaut — variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs.
#  Ne jamais publier .env : il contient des secrets.
# ------------------------------------------------------------

# Base PostgreSQL (Supabase > Connect > ORM / Prisma)
# Connexion mutualisée, utilisée par l'application (port 6543)
DATABASE_URL="postgresql://postgres.PROJET:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Connexion directe, utilisée par les migrations (port 5432)
DIRECT_URL="postgresql://postgres.PROJET:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Signature des sessions : chaîne aléatoire de 32 caractères minimum
AUTH_SECRET="a-remplacer-par-une-valeur-aleatoire-longue"

# Adresse publique du site (plan du site, partages, métadonnées)
NEXT_PUBLIC_SITE_URL="https://lebeaudefaut.vercel.app"
NEXT_PUBLIC_APP_NAME="Le Beau Défaut"

# Photos téléversées : stockage Supabase (sinon écriture dans public/uploads)
SUPABASE_URL="https://PROJET.supabase.co"
SUPABASE_SERVICE_KEY="cle-secrete-service-role-a-garder-privee"
SUPABASE_BUCKET="photos"

# Vitrine : affiche les boutons de connexion rapide aux comptes de démonstration.
# Mettre à 0 (ou supprimer) dès que de vrais clients utilisent le site.
NEXT_PUBLIC_DEMO="1"
